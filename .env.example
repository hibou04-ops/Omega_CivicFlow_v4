# ═══════════════════════════════════════════════════════
# Omega CivicFlow — 환경 설정 템플릿
# 사용법: cp .env.example .env 후 실제 값으로 교체
# ═══════════════════════════════════════════════════════

# --- Database ---
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/civicflow

# --- JWT Auth ---
JWT_SECRET_KEY=generate-random-32-char-string-here

# --- Ollama LLM ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=exaone3.5:7.8b
OLLAMA_ANALYSIS_MODEL=exaone3.5:7.8b
OLLAMA_AGENT_MODEL=exaone3.5:7.8b

# --- Vertex AI (The-Absolute Insight) ---
# 발급: https://console.cloud.google.com → IAM → Service Account → JSON 키 다운로드
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GCP_KEY_PATH=/path/to/service-account-key.json
GEMINI_MODEL=gemini-2.5-pro

# --- Omega-Prime Supervisor (Insight 감독 레이어, 선택) ---
# 비워두면 위 GCP_* 값을 재사용. 별도 프로젝트 사용 시 독립 계정 권장.
SUPERVISOR_MODEL=gemini-2.5-flash
SUPERVISOR_GCP_PROJECT_ID=
SUPERVISOR_GCP_LOCATION=us-central1
SUPERVISOR_GCP_KEY_PATH=

# --- DART OpenAPI (한국 금융 공시 검색) ---
# 발급: https://opendart.fss.or.kr (회원가입 후 무료, 일 10,000건 제한)
DART_API_KEY=your-dart-api-key

# --- Email (SMTP, 선택) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FRONTEND_URL=http://localhost:5173

# --- Upload & Data Directories ---
UPLOAD_DIR=./data/uploads
CHROMADB_DIR=./data/chroma_db
DATASET_DIR=./data/datasets
MAX_FILE_SIZE_MB=700

# --- App ---
DEV_MODE=False
