<View>
  <Header value="CivicFlow Minimal Review" />

  <View style="margin-top: 16px; padding: 12px; border: 1px solid #444;">
    <Header value="Metadata" />
    <Text name="file_name" value="$file_name" />
    <Text name="section_file" value="$section_file" />
    <Text name="section_index" value="$section_index" />
    <Text name="p_label_hint" value="$p_label_hint" />
    <Text name="doc_id" value="$doc_id" />
    <Text name="text_chars" value="$text_chars" />
  </View>

  <View style="margin-top: 16px; padding: 12px; border: 1px solid #444;">
    <Header value="Auto Hints" />
    <Text name="auto_primary_hint" value="$auto_primary_hint" />
    <Text name="auto_secondary_hint" value="$auto_secondary_hint" />
    <Text name="auto_company_hint" value="$auto_company_hint" />
    <Text name="auto_title_hint" value="$auto_title_hint" />
  </View>

  <View style="margin-top: 16px; padding: 12px; border: 1px solid #444;">
    <Header value="1. Primary Document Type" />
    <Choices name="document_type_primary" toName="document_text" choice="single-radio" showInline="true">
      <Choice value="감사보고서" />
      <Choice value="반기보고서" />
      <Choice value="분기보고서" />
      <Choice value="사업보고서" />
      <Choice value="주요사항보고서" />
      <Choice value="자기주식처분결과보고서" />
      <Choice value="기타" />
    </Choices>

    <Header value="2. Secondary Type" />
    <Choices name="document_type_secondary" toName="document_text" choice="single-radio" showInline="true">
      <Choice value="유상증자결정" />
      <Choice value="정정공시" />
      <Choice value="해당 없음" />
      <Choice value="기타" />
    </Choices>
  </View>

  <View style="margin-top: 16px; padding: 12px; border: 1px solid #444;">
    <Header value="3. Document Text" />
    <Text name="document_text" value="$text" />
  </View>
</View>
